// Icon, manifest and file properties of DB-Robot-R1-Setup.exe (see setup-stub.c).
#pragma code_page(65001)
#include <winver.h>

1 ICON "dbrobot.ico"
1 24 "setup-stub.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DB-ROBOT (dbrobot.vn)"
            VALUE "FileDescription", "DB-Robot R1 for the Phicomm R1 speaker"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "DB-Robot-R1"
            VALUE "LegalCopyright", "Copyright (C) 2026 DB_ROBOT - by @hoanganhsell"
            VALUE "OriginalFilename", "DB-Robot-R1-Setup.exe"
            VALUE "ProductName", "DB-Robot R1"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
